# Nginx конфиг для поддомена admin.businitti.ru
# Скопировать в /etc/nginx/sites-available/admin.businitti.ru
# и создать симлинк: ln -s /etc/nginx/sites-available/admin.businitti.ru /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name admin.businitti.ru;

    # Редирект на HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.businitti.ru;

    # SSL-сертификат (Let's Encrypt / Timeweb)
    ssl_certificate /etc/letsencrypt/live/admin.businitti.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.businitti.ru/privkey.pem;

    # Frontend (SPA) — статические файлы
    root /var/www/businitti-admin/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Backend API — проксирование на Node.js
    location /api/ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Увеличенный таймаут для загрузки файлов
        client_max_body_size 10m;
        proxy_read_timeout 120s;
    }

    # Health check
    location /health {
        proxy_pass http://127.0.0.1:4001;
    }
}
